PORT=8083
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fb_farol?sslmode=disable
REDIS_ADDR=localhost:6379
JWT_SECRET=dev-secret-change-in-production
COOKIE_SECURE=false
APP_MODULE=farol
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@fortesbezerra.com.br
SMTP_PASSWORD=
SMTP_FROM=FBTax Cloud <contato@fortesbezerra.com.br>
APP_URL=http://localhost:8083
ALLOWED_ORIGINS=http://localhost:3000

# API machine-to-machine consumida pelo SmartPick (Monitor de Faturamento sem
# Calibragem) — GET /api/farol/produtos-faturados. A key é vinculada a UMA
# empresa fixa do Farol (evita vazar dado entre tenants que compartilham
# códigos de filial WinThor). Sem as duas vars, o endpoint responde 503.
FAROL_API_KEY=
FAROL_API_KEY_EMPRESA_ID=
